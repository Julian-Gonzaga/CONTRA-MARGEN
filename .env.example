# Copia este archivo como ".env" y cambia los valores.

# --- Base de datos (Docker Compose usa estas tres) ---
POSTGRES_USER=contramargen
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=contramargen

# --- Conexión de la app a la base de datos (mismos datos de arriba) ---
DATABASE_URL=postgres://contramargen:cambia_esta_contrasena@localhost:5432/contramargen

# --- Clave secreta de Payload: una cadena larga y aleatoria ---
PAYLOAD_SECRET=pon_aqui_una_clave_larga_y_aleatoria

# --- URL pública del sitio ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Administrador inicial (lo crea "npm run seed") ---
ADMIN_EMAIL=admin@contramargen.com
ADMIN_PASSWORD=cambia_esta_contrasena
